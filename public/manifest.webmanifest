{
  "name": "Modulo Roads",
  "short_name": "Modulo Roads",
  "description": "A calm, endless, procedurally generated drive through Switzerland.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#0e1116",
